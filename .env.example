# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# Discord bot token (Discord Developer Portal → your app → Bot → Token)
DISCORD_TOKEN=your-discord-bot-token

# Dev mode: set to your server (guild) ID to sync slash commands to that one
# server instantly. Leave blank/unset in production for a global sync.
# DEV_GUILD_ID=123456789012345678

# Target WordPress site (no trailing slash), e.g. https://your-club.example
SITE_BASE_URL=https://your-club.example

# Club name shown in the Discord embed title
CLUB_NAME=Your Curling Club

# Number of sheets at your facility (varies by club). Used for free-sheet math.
NUM_SHEETS=4

# Gravity Forms REST API v2 credentials (WP Admin → Forms → Settings → REST API).
# Passed as query params, so they work even when a proxy strips Authorization headers.
GF_CONSUMER_KEY=ck_your_consumer_key
GF_CONSUMER_SECRET=cs_your_consumer_secret

# Subs board (optional — sensible defaults)
# Club UTC offset used to parse/display sub-request game times (CST = -5)
TIMEZONE_OFFSET=-5
# Where the subs board state is stored
SUBS_STORE_PATH=subs_store.json
# Where the practice sign-up pool is stored
PRACTICE_STORE_PATH=practice_signups.json
# Hours after a game's start time before its request auto-expires
SUBS_GRACE_HOURS=3

# Optional: a real league post id for discover_leagues.py exploration
# TEST_LEAGUE_ID=0
