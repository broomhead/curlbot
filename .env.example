# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# Discord bot token (Discord Developer Portal → your app → Bot → Token)
DISCORD_TOKEN=your-discord-bot-token

# Dev mode: set to your server (guild) ID to sync slash commands to that one
# server instantly. Leave blank/unset in production for a global sync.
# DEV_GUILD_ID=123456789012345678

# Target WordPress site (no trailing slash), e.g. https://your-club.example
SITE_BASE_URL=https://your-club.example

# Club name shown in the Discord embed title
CLUB_NAME=Your Curling Club

# Number of sheets at your facility (varies by club). Used for free-sheet math.
NUM_SHEETS=4

# How long (hours) a session keeps showing in /sheets after it ends, so a
# just-finished slot stays visible to latecomers. 0 = hard cutoff at end time.
# SHEETS_GRACE_HOURS=1

# Ad-hoc sheet blocks: ice reserved outside the calendar, held by hand from the
# 🚫 button on /sheets so the report stops offering sheets that are taken.
# Same idea as SHEETS_GRACE_HOURS — how long a finished block lingers before the
# bot sweeps it.
# BLOCK_GRACE_HOURS=1

# Facility-reserved curling ice (optional). If your rink publishes a Google
# Calendar of its ice schedule, point this at the public iCal URL(s) of the
# calendar(s) that carry your reserved curling blocks (comma-separated). The bot
# shows any curling-marked block that none of your club events overlap as open
# practice ice. Get the URL from the calendar embed's src id:
#   https://calendar.google.com/calendar/ical/<CALENDAR_ID>/public/basic.ics
# POND_ICS_URLS=https://calendar.google.com/calendar/ical/xxxxx%40group.calendar.google.com/public/basic.ics
# Title keyword that marks a block as curling (case-insensitive; default "curl")
# POND_MATCH=curl
# How long to cache the feed, in seconds (default 21600 = 6h)
# POND_CACHE_TTL=21600

# Gravity Forms REST API v2 credentials (WP Admin → Forms → Settings → REST API).
# Passed as query params, so they work even when a proxy strips Authorization headers.
# REQUIRED, in every environment, alongside DISCORD_TOKEN — the bot refuses to
# start without all three. They're secrets, so they belong in the env file the
# deployment ships, never in a committed compose file. (A .env sitting in the
# image is NOT a substitute: .dockerignore keeps it out on purpose.)
GF_CONSUMER_KEY=ck_your_consumer_key
GF_CONSUMER_SECRET=cs_your_consumer_secret

# Subs board (optional — sensible defaults)
# Club UTC offset used to parse/display sub-request game times (CST = -5)
TIMEZONE_OFFSET=-5

# Data output files
LEAGUE_CACHE_PATH=./data/league_cache.json
PRACTICE_STORE_PATH=./data/practice_signups.json
SUBS_STORE_PATH=./data/subs_store.json
BLOCK_STORE_PATH=./data/sheet_blocks.json

# Hours after a game's start time before its request auto-expires
SUBS_GRACE_HOURS=3

# Days a LEGACY sub request with no game date lasts before ageing out. The UI no
# longer creates these (a date is always required), but records made while it did
# have nothing to expire against, so they go by when they were posted.
SUBS_UNDATED_DAYS=14

# How many days ahead the subs board lists in full. Past this, games condense to
# one line with a 'Show all' button (a Discord embed cannot scroll, and a season-long
# league run would bury the games people can still act on). Default 14.
SUBS_BOARD_DAYS=14

# How close to game time an AUTO-ASSIGNED go-to sub who still hasn't confirmed gets
# chased (once, in the channel the request came from). Deliberately longer than the
# 24h unfilled-game reminder: an unconfirmed assignment is the one case where the
# board reads as covered and might not be, so it has to surface while there's still
# time to find somebody else. The spot is never reopened by the chase.
SUBS_ACK_HOURS=48

# Max people on one sheet of ice. Used both by /sheets (how much ice an LTC
# takes) and by the instructor board (how many instructors it needs).
PEOPLE_PER_SHEET=8

# Optional: a real league post id for discover_leagues.py exploration
# TEST_LEAGUE_ID=0

# ── Instructor board (Discord) ───────────────────────────────────────────────
# Optional. Posts which upcoming LTCs / events are short of instructors, read
# from a Google Sheet. Leave INSTRUCTOR_CHANNEL_ID or SHEET_ID empty and the
# whole feature stays off.

# Channel the board lives in. Turn on Developer Mode in Discord, right click the
# channel, Copy Channel ID.
INSTRUCTOR_CHANNEL_ID=

# The instructor sheet: the id from docs.google.com/spreadsheets/d/<SHEET_ID>/edit
# Must stay shared as "anyone with the link can view" - the bot reads the public
# CSV export and holds no Google credentials.
SHEET_ID=
SHEET_GID=

# Club-local times to check the sheet (24h, comma separated). The board is only
# reposted when its content actually changed, so extra checks are cheap.
CHECK_TIMES=09:00,16:00
# How far ahead to list events.
HORIZON_DAYS=60
# How close an event has to be before a gap in it counts as urgent: the board
# splits into "needs instructors now" and "coming up later" here, and only the
# near group can turn the board red.
URGENT_DAYS=14
# Staffing: sheets of ice (see NUM_SHEETS / PEOPLE_PER_SHEET above) times these.
INSTRUCTORS_PER_SHEET=2
MIN_INSTRUCTORS_PER_SHEET=1
# Closing line of the board. Name your coordinator here if you like.
BOARD_FOOTER=
